# Copy this file to ".env" and fill in your own values. Never commit ".env".

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/library_management
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Library rules (configurable)
BORROW_DAYS=14
FINE_PER_DAY=5
MAX_ACTIVE_ISSUES=5

# Used ONLY by "npm run seed" to create demo accounts
SEED_ADMIN_EMAIL=admin@library.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_STUDENT_PASSWORD=Student@123
